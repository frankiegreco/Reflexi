# Segreti — mai in git (password DB, SMTP, chiavi Stripe)
.env
webroot/.env

# Export bancari reali caricati per testare l'import CSV/XLSX (dati personali:
# saldo, stipendio, numero conto — mai in git, nemmeno in un repo locale)
docs/*.xlsx
docs/*.csv

# Dipendenze rigenerabili
frontend/node_modules/
webroot/vendor/

# Build intermedie del frontend (webroot/app/ è il build effettivamente
# servito e resta versionato; queste sono solo passaggi intermedi locali)
frontend/dist/
frontend/dist_incoming/

# OS / editor
.DS_Store
*.swp

# Impostazioni locali di Claude Code (personali, non condivise)
.claude/settings.local.json

# Elenco intermedio generato da build/og/generate.py
build/og/items.json
__pycache__/

# Backup del go-live Stripe: dump con dati utenti e .env con le chiavi di test
backup_*.sql
.env.test-backup

# Documenti e immagini solo locali, mai nel repo (pubblicabile): checklist
# operativa Stripe e screenshot con dati finanziari reali
GO_LIVE_STRIPE.md
foto.png
screen.jpeg

# Note interne per Claude Code: solo in locale, non pubblicate
CLAUDE.md

# Guida PDF: generata da build/guida/generate.py, riservata agli iscritti
# (non va pubblicata su GitHub). guida.html e' il sorgente intermedio.
webroot/private/
build/guida/guida.html
