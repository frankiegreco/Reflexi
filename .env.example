# Copia questo file in ".env" e personalizza i valori prima di avviare docker compose

DB_ROOT_PASSWORD=scegli_una_password_root_sicura
DB_NAME=finanze
DB_USER=finanze_user
DB_PASSWORD=scegli_una_password_sicura

# Porta su cui sarà raggiungibile l'app dentro la tua rete locale
WEB_PORT=8080

# Dominio/i per cui Caddy ottiene automaticamente il certificato HTTPS.
# In locale/homelab lascia "localhost". In produzione: il tuo dominio reale,
# es. "reflexi.it, www.reflexi.it" (separati da virgola se più di uno).
SITE_ADDRESS=localhost

# Porta per Adminer (gestione DB via browser). Puoi rimuoverlo da docker-compose.yml se non ti serve
ADMINER_PORT=8081

# URL con cui l'app è raggiungibile: usato nei link delle email (verifica, reset password).
# Su XAMPP in sottocartella: es. http://localhost/finance-tracker/webroot
APP_URL=http://localhost:8080

# SMTP per le email di verifica account e reset password.
# Se lasci SMTP_HOST vuoto, le email non vengono inviate (solo loggate) e
# registrazione/reset restano bloccati finché non configuri un provider SMTP
# reale (es. un account Gmail con password per le app, Mailtrap per i test,
# SendGrid, Brevo, ecc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=no-reply@localhost
SMTP_FROM_NAME=Le mie finanze

# Interfaccia del Checkout Stripe: "hosted" (redirect alla pagina di Stripe,
# predefinito) oppure "form" (embedded form dentro l'app, richiede
# VITE_STRIPE_PUBLISHABLE_KEY in frontend/.env al momento del build).
STRIPE_CHECKOUT_UI=hosted
