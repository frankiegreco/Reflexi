# Copia questo file in "webroot/.env" (stessa cartella di questo file) e
# personalizza i valori. Su XAMPP non esistono le variabili d'ambiente di
# Docker Compose, quindi questo file le sostituisce solo per SMTP e APP_URL
# (le credenziali del database restano quelle che hai già in api/db.php/XAMPP).

APP_URL=http://localhost/finance-tracker/webroot

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=no-reply@localhost
SMTP_FROM_NAME=Reflexi
